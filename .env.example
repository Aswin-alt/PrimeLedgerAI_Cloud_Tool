# PrimeLedgerAI Cloud — production template for tool.primeledgerai.com
# Copy to .env on the server and replace every CHANGE_ME / placeholder value.
# Never commit a real .env file.

# MySQL on the same host (recommended for production)
DATABASE_URL=mysql+pymysql://pla:CHANGE_ME@127.0.0.1:3306/primeledger?charset=utf8mb4

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING

# Session cookie age in seconds (default 12 hours)
SESSION_MAX_AGE=43200

# Require HTTPS for the session cookie (set true behind Nginx + Let's Encrypt)
SESSION_HTTPS_ONLY=true

# Seeded admin account (change password immediately after first login)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DEFAULT_ADMIN_EMAIL=admin@primeledgerai.com

# Absolute paths on the Ubuntu server
UPLOAD_DIR=/opt/primeledger/webapp/uploads
OUTPUT_DIR=/opt/primeledger/webapp/outputs
LEGACY_ROOT=/opt/primeledger
